diff --git a/tests/test_auth_publickey_signed.c b/tests/test_auth_publickey_signed.c
new file mode 100644
index 00000000..fe2382bf
--- /dev/null
+++ b/tests/test_auth_publickey_signed.c
@@ -0,0 +1,122 @@
+/* Copyright (C) 2026 Kaede Akino
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#include "libssh2_priv.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const unsigned char signature[] =
+    "\0\0\0\x27" "webauthn-sk-ecdsa-sha2-nistp256@openssh.com"
+    "\0\0\0\x0c" "test-r-and-s" "\1\0\0\0\7"
+    "\0\0\0\6" "origin";
+static int calls;
+static int invalid;
+
+static LIBSSH2_SEND_FUNC(would_block)
+{
+    (void)socket; (void)buffer; (void)length; (void)flags; (void)abstract;
+    return -EAGAIN;
+}
+
+static LIBSSH2_USERAUTH_PUBLICKEY_SIGN_FUNC(sign_complete)
+{
+    (void)abstract;
+    if(data_len != 9 || memcmp(data, "\0\0\0\4test\1", 9))
+        return LIBSSH2_ERROR_INVAL;
+    if(calls++ == 0)
+        return LIBSSH2_ERROR_EAGAIN;
+    if(invalid == 2)
+        return 0; /* A successful callback must supply output. */
+    *sig_len = invalid ? 4 : sizeof(signature) - 1;
+    *sig = LIBSSH2_ALLOC(session, *sig_len);
+    if(!*sig)
+        return LIBSSH2_ERROR_ALLOC;
+    memcpy(*sig, signature, *sig_len);
+    return 0;
+}
+
+static int check(int bad_signature, int complete)
+{
+    LIBSSH2_SESSION *s = libssh2_session_init();
+    const char *method = complete ? "sk-ecdsa-sha2-nistp256@openssh.com" :
+                                   "ssh-ed25519";
+    int rc, failed = 0;
+    if(!s)
+        return 1;
+    libssh2_session_set_blocking(s, 0);
+    s->send = would_block;
+    s->session_id_len = 4;
+    s->session_id = LIBSSH2_ALLOC(s, 4);
+    memcpy(s->session_id, "test", 4);
+    s->userauth_pblc_state = libssh2_NB_state_sent1;
+    s->userauth_pblc_method_len = strlen(method);
+    s->userauth_pblc_method = LIBSSH2_ALLOC(s, strlen(method));
+    memcpy(s->userauth_pblc_method, method, strlen(method));
+    s->userauth_pblc_packet = LIBSSH2_ALLOC(s, 1);
+    s->userauth_pblc_packet[0] = 1;
+    s->userauth_pblc_packet_len = 1;
+    calls = 0;
+    invalid = bad_signature;
+    rc = (complete ? libssh2_userauth_publickey_signed :
+                     libssh2_userauth_publickey)(s, "user",
+                                           (const unsigned char *)"key", 3,
+                                           sign_complete, NULL);
+    if(rc != LIBSSH2_ERROR_EAGAIN || calls != 1 ||
+       s->userauth_pblc_state != libssh2_NB_state_sent1)
+        failed = 1;
+    rc = (complete ? libssh2_userauth_publickey_signed :
+                     libssh2_userauth_publickey)(s, "user",
+                                           (const unsigned char *)"key", 3,
+                                           sign_complete, NULL);
+    if(bad_signature) {
+        if(rc != LIBSSH2_ERROR_PUBLICKEY_UNVERIFIED ||
+           s->userauth_pblc_state != libssh2_NB_state_idle)
+            failed = 1;
+    }
+    else {
+        if(rc != LIBSSH2_ERROR_EAGAIN ||
+           s->userauth_pblc_state != libssh2_NB_state_sent2)
+            failed = 1;
+        if(complete) {
+            if(_libssh2_ntohu32(s->userauth_pblc_packet + 1) !=
+               sizeof(signature) - 1 ||
+               memcmp(s->userauth_pblc_packet + 5, signature,
+                      sizeof(signature) - 1))
+                failed = 1;
+        }
+        else {
+            const unsigned char *p = s->userauth_pblc_packet + 1;
+            if(_libssh2_ntohu32(p) != 8 + strlen(method) +
+               sizeof(signature) - 1 ||
+               _libssh2_ntohu32(p + 4) != strlen(method) ||
+               memcmp(p + 8, method, strlen(method)) ||
+               _libssh2_ntohu32(p + 8 + strlen(method)) !=
+               sizeof(signature) - 1 ||
+               memcmp(p + 12 + strlen(method), signature,
+                      sizeof(signature) - 1))
+                failed = 1;
+        }
+        rc = (complete ? libssh2_userauth_publickey_signed :
+                     libssh2_userauth_publickey)(s, "user",
+                                               (const unsigned char *)"key", 3,
+                                               sign_complete, NULL);
+        if(rc != LIBSSH2_ERROR_EAGAIN || calls != 2)
+            failed = 1;
+    }
+    libssh2_session_free(s);
+    return failed;
+}
+
+int main(void)
+{
+    int failed;
+    if(libssh2_init(0))
+        return 1;
+    failed = check(0, 1) | check(1, 1) | check(2, 1) | check(0, 0);
+    libssh2_exit();
+    if(failed)
+        fprintf(stderr, "complete-signature authentication regression\n");
+    return failed;
+}
