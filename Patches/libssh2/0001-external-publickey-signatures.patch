+/* Callback returns a complete SSH signature blob, including algorithm.
+ * Allocate successful output with the session allocator; libssh2 frees it.
+ * For a pending asynchronous signer, return EAGAIN without allocated output
+ * and retry the same API on a nonblocking session with unchanged inputs.
+ * Do not switch between legacy and complete-signature APIs during a retry.
+ */
+LIBSSH2_API int
+libssh2_userauth_publickey_signed(LIBSSH2_SESSION *session,
+                           const char *username,
+                           const unsigned char *pubkeydata,
+                           size_t pubkeydata_len,
+                           LIBSSH2_USERAUTH_PUBLICKEY_SIGN_FUNC
+                               ((*sign_callback)),
+                           void **abstract);
