 /*
  * userauth_publickey_frommemory
  * Authenticate using a keypair from memory
@@ -2091,6 +2125,28 @@ libssh2_userauth_publickey(LIBSSH2_SESSION *session,
 
 
 
+/* The callback returns the entire SSH signature blob, including its
+ * algorithm string. This supports external signers whose signature format
+ * differs from the public key format (for example WebAuthn ECDSA-SK). */
+LIBSSH2_API int
+libssh2_userauth_publickey_signed(LIBSSH2_SESSION *session,
+                                 const char *user,
+                                 const unsigned char *pubkeydata,
+                                 size_t pubkeydata_len,
+                                 LIBSSH2_USERAUTH_PUBLICKEY_SIGN_FUNC
+                                     ((*sign_callback)),
+                                 void **abstract)
+{
+    int rc;
+    if(!session || !user || !pubkeydata || !sign_callback)
+        return LIBSSH2_ERROR_BAD_USE;
+    BLOCK_ADJUST(rc, session,
+                 userauth_publickey_signed(session, user, strlen(user),
+                                           pubkeydata, pubkeydata_len,
+                                           sign_callback, abstract, 1));
+    return rc;
+}
